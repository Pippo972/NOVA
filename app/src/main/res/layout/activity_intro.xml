<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Pagina 1: presentazione -->
    <LinearLayout
        android:id="@+id/page1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/nova_navy"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="NOVA"
            android:src="@drawable/nova_logo_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/outfit_light"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:text="Nuova Opportunità per Vecchi Apparecchi"
            android:textColor="@color/nova_soft"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/outfit_light"
            android:gravity="center"
            android:text="Diagnosi completa dello smartphone, via cavo, in pochi secondi."
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Pagina 2: benvenuto -->
    <LinearLayout
        android:id="@+id/page2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/nova_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_semibold"
            android:lineSpacingMultiplier="1.1"
            android:text="Valuta.\nRigenera.\nRivendi."
            android:textColor="@color/nova_blue"
            android:textSize="56sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:fontFamily="@font/outfit_light"
            android:text="Benvenuto in"
            android:textColor="@color/nova_ink"
            android:textSize="26sp" />

        <ImageView
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:adjustViewBounds="true"
            android:contentDescription="NOVA"
            android:src="@drawable/nova_logo_navy" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/introButton"
        android:layout_width="240dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="32dp"
        android:backgroundTint="@color/nova_blue"
        android:text="Avanti"
        android:textSize="20sp"
        app:cornerRadius="32dp" />
</FrameLayout>
